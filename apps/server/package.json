{
  "name": "@customize-agent/server",
  "version": "4.12.11",
  "description": "Customize Agent Web 管理控制台",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "customize-web": "scripts/start-server.cjs",
    "customize-dashboard": "scripts/start-server.cjs"
  },
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\" && next dev -p 17321",
    "build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\" && next build && node -e \"const fs=require('fs'); for (const p of ['.next/cache','.next/static/development','.next/static/webpack']) fs.rmSync(p, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\" && node scripts/verify-next-static.js",
    "prepack": "node -e \"const fs=require('fs'); for (const p of ['.next/cache','.next/static/development','.next/static/webpack']) fs.rmSync(p, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 })\" && node scripts/verify-next-static.js --silent",
    "prestart": "node scripts/verify-next-static.js",
    "start": "next start -p 17321",
    "lint": "eslint src/"
  },
  "files": [
    ".next/BUILD_ID",
    ".next/app-build-manifest.json",
    ".next/build-manifest.json",
    ".next/fallback-build-manifest.json",
    ".next/server",
    ".next/static",
    ".next/required-server-files.json",
    ".next/routes-manifest.json",
    ".next/prerender-manifest.json",
    ".next/images-manifest.json",
    ".next/react-loadable-manifest.json",
    "public",
    "messages",
    "next.config.ts",
    "postcss.config.mjs",
    "scripts",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@customize-agent/knowledge": "^4.1.2",
    "@customize-agent/llm": "^3.1.0",
    "@customize-agent/runtime": "^3.1.0",
    "@napi-rs/canvas": "^0.1.82",
    "@types/nprogress": "^0.2.3",
    "antd": "^6.5.0",
    "better-sqlite3": "^12.10.0",
    "formidable": "^3.5.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "next": "15.5.19",
    "next-themes": "^0.4.0",
    "nprogress": "^0.2.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.394",
    "playwright": "^1.57.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/formidable": "^3.4.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.4.49",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.2"
  }
}
